# Copy to .env.local (gitignored). Do not prefix names with VITE_.
# Access application needs a separate policy with action Service Auth for this token.
SANTAIZI_DEV_UPSTREAM=https://dash.example.com
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
SANTAIZI_API_TOKEN=
# Optional: paste CF_Authorization cookie if Service Auth is not enabled yet.
# CF_AUTHORIZATION=
# SANTAIZI_DEV_STATUS_BEARER=1
